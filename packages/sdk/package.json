{
  "name": "coss",
  "version": "0.6.0",
  "description": "The official TypeScript SDK for coss.com: email, SMS, video, scheduling and more behind one API key.",
  "license": "MIT",
  "homepage": "https://coss.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosscom/coss.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/cosscom/coss/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./authjs": "./dist/authjs.js",
    "./better-auth": "./dist/better-auth.js",
    "./device": "./dist/device.js",
    "./diagnose": "./dist/diagnose.js",
    "./nodemailer": "./dist/nodemailer.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "peerDependencies": {
    "@auth/core": ">=0.37.0",
    "@react-email/render": "^1.0.0 || ^2.0.0",
    "better-auth": ">=1.0.0",
    "nodemailer": ">=6.9.0"
  },
  "peerDependenciesMeta": {
    "@auth/core": {
      "optional": true
    },
    "@react-email/render": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@auth/core": "0.41.3",
    "@react-email/render": "2.1.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "better-auth": "1.7.7",
    "nodemailer": "10.0.13",
    "publint": "0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

{
  "name": "coss",
  "version": "0.3.0",
  "description": "The official TypeScript SDK for coss.com: email, SMS, video, scheduling and more behind one API key.",
  "license": "MIT",
  "homepage": "https://coss.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosscom/coss.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/cosscom/coss/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./device": "./dist/device.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "peerDependencies": {
    "@react-email/render": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@react-email/render": "2.1.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "publint": "0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

{
  "name": "coss-cli",
  "version": "0.2.0",
  "description": "The coss.com command line: sign in, send test emails and text messages, tail your environment's log, and forward webhook events to localhost with `coss listen`.",
  "license": "MIT",
  "homepage": "https://coss.com/docs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosscom/coss.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/cosscom/coss/issues",
  "keywords": [
    "coss",
    "cli",
    "email",
    "sms",
    "webhooks",
    "logs"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "coss": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "build:binaries": "bun scripts/binaries.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "coss": "^0.7.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@types/bun": "1.4.2",
    "@types/node": "^24",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

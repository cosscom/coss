{
  "name": "coss-mcp",
  "version": "0.0.0",
  "description": "MCP server for COSS: lets coding agents look up emails, diagnose delivery, and manage domains, suppressions and webhooks.",
  "license": "MIT",
  "homepage": "https://coss.com/docs/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosscom/coss.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/cosscom/coss/issues",
  "keywords": [
    "coss",
    "mcp",
    "model-context-protocol",
    "email",
    "ai",
    "agents"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "coss-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "coss": "^0.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/bun": "1.4.2",
    "@types/node": "^24",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

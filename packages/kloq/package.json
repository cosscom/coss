    "./styles.css": "./src/styles/kloq.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",

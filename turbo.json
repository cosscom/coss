{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "DATABASE_POOL_MAX",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "NEXT_PUBLIC_API_URL",
    "API_PORT",
    "API_PUBLIC_URL",
    "EMAIL_PROVIDER",
    "AWS_REGION",
    "SES_CONFIGURATION_SET",
    "SES_TENANT_PREFIX",
    "SES_EVENTS_QUEUE_URL",
    "WEBHOOK_SECRETS_KEY",
    "VALKEY_URL",
    "VALKEY_CLUSTER",
    "TEST_VALKEY_URL",
    "RATE_LIMIT_KEY_PREFIX",
    "CLIENT_IP_HEADER",
    "TRUSTED_PROXY_COUNT",
    "SKIP_ENV_VALIDATION"
  ],
  "globalPassThroughEnv": [
    "AWS_PROFILE",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "AWS_DEFAULT_REGION",
    "AWS_SHARED_CREDENTIALS_FILE",
    "AWS_CONFIG_FILE",
    "AWS_ROLE_ARN",
    "AWS_WEB_IDENTITY_TOKEN_FILE",
    "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI",
    "AWS_CONTAINER_CREDENTIALS_FULL_URI",
    "AWS_CONTAINER_AUTHORIZATION_TOKEN"
  ],
  "globalDependencies": [".env"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit", "^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

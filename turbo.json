{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "futureFlags": {
    "longerSignatureKey": true
  },
  "remoteCache": {
    "signature": true
  },
  "globalEnv": ["NODE_ENV", "NEXT_DEPLOYMENT_ID"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "DATABASE_POOL_MAX",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "API_PORT",
    "API_PUBLIC_URL",
    "API_CORS_ORIGINS",
    "EMAIL_PROVIDER",
    "AWS_REGION",
    "SES_CONFIGURATION_SET",
    "SES_TENANT_PREFIX",
    "TRACKING_DOMAIN_PROVIDER",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ZONE_ID",
    "TRACKING_CNAME_TARGET",
    "SES_EVENTS_QUEUE_URL",
    "NOTIFICATIONS_ENVIRONMENT_ID",
    "NOTIFICATIONS_FROM",
    "WEBHOOK_SECRETS_KEY",
    "SCREENING_CLASSIFIER",
    "SCREENING_MODEL",
    "AI_GATEWAY_API_KEY",
    "VALKEY_URL",
    "VALKEY_CLUSTER",
    "TEST_VALKEY_URL",
    "RATE_LIMIT_KEY_PREFIX",
    "CLIENT_IP_HEADER",
    "TRUSTED_PROXY_COUNT",
    "SKIP_ENV_VALIDATION",
    "SKIP_BUILD_TYPECHECK",
    "TRUSTED_PROXY_HOPS",
    "TURNSTILE_SITE_KEY",
    "TURNSTILE_SECRET_KEY",
    "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY",
    "LOG_RETENTION_DAYS",
    "SENTRY_DSN",
    "SENTRY_ENVIRONMENT",
    "SENTRY_TRACES_SAMPLE_RATE",
    "SENTRY_RELEASE",
    "AWS_PROFILE",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "AWS_DEFAULT_REGION",
    "AWS_SHARED_CREDENTIALS_FILE",
    "AWS_CONFIG_FILE",
    "AWS_ROLE_ARN",
    "AWS_WEB_IDENTITY_TOKEN_FILE",
    "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI",
    "AWS_CONTAINER_CREDENTIALS_FULL_URI",
    "AWS_CONTAINER_AUTHORIZATION_TOKEN",
    "NEXT_TELEMETRY_DISABLED",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit", "^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

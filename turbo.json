{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "futureFlags": {
    "longerSignatureKey": true
  },
  "remoteCache": {
    "signature": true
  },
  "globalEnv": ["NODE_ENV", "NEXT_DEPLOYMENT_ID"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "DATABASE_POOL_MAX",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "API_PORT",
    "API_PUBLIC_URL",
    "PORTAL_PUBLIC_URL",
    "SIGN_PUBLIC_URL",
    "SIGN_DOCUMENTS_BUCKET",
    "SIGN_SEALER",
    "SIGN_SEAL_KMS_KEY_ID",
    "SIGN_SEAL_CERTIFICATE_CHAIN",
    "SIGN_CSC_URL",
    "SIGN_CSC_TOKEN_URL",
    "SIGN_CSC_CLIENT_ID",
    "SIGN_CSC_CLIENT_SECRET",
    "SIGN_CSC_USERNAME",
    "SIGN_CSC_PASSWORD",
    "SIGN_CSC_CREDENTIAL_ID",
    "SIGN_CSC_TOTP_SECRET",
    "SIGN_TSA_URL",
    "SIGN_NOTIFICATIONS_FROM",
    "WORKER_LOOPS",
    "API_CORS_ORIGINS",
    "EMAIL_PROVIDER",
    "AWS_REGION",
    "SES_CONFIGURATION_SET",
    "SES_TENANT_PREFIX",
    "TRACKING_DOMAIN_PROVIDER",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ZONE_ID",
    "TRACKING_CNAME_TARGET",
    "TRACKING_PUBLIC_URL",
    "SES_EVENTS_QUEUE_URL",
    "SES_INBOUND_QUEUE_URL",
    "SES_INBOUND_BUCKET",
    "INBOUND_MANAGED_DOMAIN",
    "SMTP_HOSTNAME",
    "SMTP_PUBLIC_HOST",
    "SMTP_IMPLICIT_TLS_PORT",
    "SMTP_STARTTLS_PORT",
    "SMTP_TLS_CERTIFICATE_ARN",
    "SMTP_TLS_PASSPHRASE",
    "SMTP_TLS_CERT_FILE",
    "SMTP_TLS_KEY_FILE",
    "NOTIFICATIONS_ENVIRONMENT_ID",
    "NOTIFICATIONS_FROM",
    "VERIFY_SMS_ENVIRONMENT_ID",
    "VERIFY_SMS_FROM",
    "APNS_KEY_ID",
    "APNS_TEAM_ID",
    "APNS_PRIVATE_KEY",
    "APNS_TOPIC",
    "APNS_ENVIRONMENTS",
    "WEBHOOK_SECRETS_KEY",
    "EMAIL_LINK_KEYS",
    "RISK_HASH_KEY",
    "RISK_CLASSIFIER",
    "RISK_IP_PRIVACY",
    "IPINFO_PRIVACY_TOKEN",
    "RISK_PHONE_LOOKUP",
    "RISK_PHONE_SIM_SWAP",
    "RISK_SIGNUP_ENVIRONMENT_ID",
    "IPINFO_TOKEN",
    "SCREENING_CLASSIFIER",
    "SCREENING_MODEL",
    "AI_GATEWAY_API_KEY",
    "VALKEY_URL",
    "VALKEY_CLUSTER",
    "TEST_VALKEY_URL",
    "RATE_LIMIT_KEY_PREFIX",
    "CLIENT_IP_HEADER",
    "TRUSTED_PROXY_COUNT",
    "SKIP_ENV_VALIDATION",
    "SKIP_BUILD_TYPECHECK",
    "TRUSTED_PROXY_HOPS",
    "TURNSTILE_SITE_KEY",
    "TURNSTILE_SECRET_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "DEPLOY_GITHUB_APP_ID",
    "DEPLOY_GITHUB_APP_PRIVATE_KEY",
    "DOMAIN_CONNECT_KEY_ID",
    "DOMAIN_CONNECT_PRIVATE_KEY",
    "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY",
    "LOG_RETENTION_DAYS",
    "SENTRY_DSN",
    "SENTRY_ENVIRONMENT",
    "SENTRY_TRACES_SAMPLE_RATE",
    "SENTRY_RELEASE",
    "AWS_PROFILE",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "AWS_DEFAULT_REGION",
    "AWS_SHARED_CREDENTIALS_FILE",
    "AWS_CONFIG_FILE",
    "AWS_ROLE_ARN",
    "AWS_WEB_IDENTITY_TOKEN_FILE",
    "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI",
    "AWS_CONTAINER_CREDENTIALS_FULL_URI",
    "AWS_CONTAINER_AUTHORIZATION_TOKEN",
    "NEXT_TELEMETRY_DISABLED",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "BILLING_PROVIDER",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "SMS_PROVIDER",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_PRIMARY_CUSTOMER_PROFILE_SID",
    "SMS_SUBACCOUNT_PREFIX"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit", "^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

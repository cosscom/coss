{
  "name": "coss-monorepo",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*",
      "infra"
    ],
    "catalog": {
      "@arethetypeswrong/core": "0.18.5",
      "@auth/core": "0.41.3",
      "@aws-sdk/client-accessanalyzer": "3.1141.0",
      "@aws-sdk/client-acm": "3.1141.0",
      "@aws-sdk/client-artifact": "3.1141.0",
      "@aws-sdk/client-cloudfront": "3.1141.0",
      "@aws-sdk/client-cloudtrail": "3.1141.0",
      "@aws-sdk/client-cloudwatch": "3.1141.0",
      "@aws-sdk/client-cloudwatch-logs": "3.1141.0",
      "@aws-sdk/client-config-service": "3.1141.0",
      "@aws-sdk/client-elastic-load-balancing-v2": "3.1141.0",
      "@aws-sdk/client-elasticache": "3.1141.0",
      "@aws-sdk/client-eventbridge": "3.1141.0",
      "@aws-sdk/client-guardduty": "3.1141.0",
      "@aws-sdk/client-iam": "3.1141.0",
      "@aws-sdk/client-s3": "3.1141.0",
      "@aws-sdk/client-securityhub": "3.1141.0",
      "@aws-sdk/client-ses": "3.1141.0",
      "@aws-sdk/client-sesv2": "3.1141.0",
      "@aws-sdk/client-sns": "3.1141.0",
      "@aws-sdk/client-sqs": "3.1141.0",
      "@aws-sdk/client-sts": "3.1141.0",
      "@base-ui/react": "1.9.0",
      "@better-auth/api-key": "1.7.16",
      "@better-auth/core": "1.7.16",
      "@better-auth/passkey": "1.7.16",
      "@better-auth/scim": "1.7.16",
      "@better-auth/sso": "1.7.16",
      "@hono/zod-openapi": "1.6.3",
      "@sentry/bun": "11.6.0",
      "@sentry/core": "11.6.0",
      "@sentry/nextjs": "11.6.0",
      "@t3-oss/env-core": "0.13.11",
      "@t3-oss/env-nextjs": "0.13.11",
      "@tailwindcss/postcss": "4.3.3",
      "@types/bun": "1.4.2",
      "@types/node": "^24",
      "@types/nodemailer": "8.0.2",
      "@types/pg": "8.23.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "ai": "7.0.137",
      "auth": "1.7.16",
      "better-auth": "1.7.16",
      "drizzle-kit": "0.31.11",
      "drizzle-orm": "0.45.4",
      "hono": "4.13.13",
      "iovalkey": "0.4.0",
      "lucide-react": "1.54.0",
      "next": "16.4.3",
      "next-auth": "5.0.0-beta.32",
      "nodemailer": "10.3.1",
      "pg": "8.23.1",
      "pg-boss": "12.33.7",
      "postcss": "8.5.29",
      "publint": "0.3.25",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "server-only": "0.0.1",
      "tailwindcss": "4.3.3",
      "tsdown": "0.23.0",
      "typescript": "7.0.2",
      "zod": "4.6.7"
    }
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "node-forge": "1.4.2",
    "undici": "7.30.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "bun run db:migrate:test && turbo run test",
    "lint": "biome ci .",
    "verify": "biome ci . && bun run db:migrate:test && TURBO_SCM_BASE=origin/main turbo run typecheck test --affected",
    "format": "biome check --write .",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:migrate:test": "bun run --cwd packages/db db:migrate:test",
    "db:studio": "bun run --cwd packages/db db:studio",
    "db:seed": "bun run --cwd packages/tenancy db:seed && bun run --cwd packages/billing db:seed && bun run --cwd packages/scheduling db:seed",
    "billing:close-period": "bun run --cwd packages/billing close-period --",
    "sms:update-prices": "bun run --cwd packages/billing sms:update-prices --",
    "admin:create": "bun run --cwd packages/tenancy admin:create",
    "ses:bootstrap": "bun run --cwd apps/worker ses:bootstrap",
    "webhooks:reencrypt": "bun run --cwd apps/worker webhooks:reencrypt",
    "scheduling:reencrypt": "bun run --cwd apps/worker scheduling:reencrypt",
    "valkey:bootstrap": "bun run --cwd packages/ratelimit valkey:bootstrap",
    "ratelimit:set": "bun run --cwd packages/ratelimit ratelimit:set",
    "auth:generate": "bun run --cwd packages/auth auth:generate && biome check --write packages/db/src/schema/auth.ts",
    "domain-connect:key": "bun run --cwd packages/email domain-connect:key",
    "signals:update-disposable": "bun run --cwd packages/signals signals:update-disposable",
    "openapi:generate": "bun run --cwd apps/api openapi:generate && bun run --cwd packages/sdk routes:generate",
    "sdks:generate": "bun run --cwd tooling/sdkgen generate",
    "changeset": "changeset",
    "version-packages": "changeset version && bun packages/sdk/scripts/sync-version.ts && bun packages/mcp/scripts/sync-server-json.ts && bun install --lockfile-only && biome check --write packages/sdk/package.json packages/sdk/src/version.ts packages/mcp/package.json packages/mcp/server.json packages/cli/package.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "turbo": "2.11.7",
    "typescript": "catalog:"
  }
}

{
  "name": "coss-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*",
      "infra"
    ],
    "catalog": {
      "@arethetypeswrong/core": "0.18.5",
      "@aws-sdk/client-cloudwatch": "3.1141.0",
      "@aws-sdk/client-elasticache": "3.1141.0",
      "@aws-sdk/client-eventbridge": "3.1141.0",
      "@aws-sdk/client-iam": "3.1141.0",
      "@aws-sdk/client-sesv2": "3.1141.0",
      "@aws-sdk/client-sns": "3.1141.0",
      "@aws-sdk/client-sqs": "3.1141.0",
      "@base-ui/react": "1.9.0",
      "@better-auth/api-key": "1.7.7",
      "@better-auth/core": "1.7.7",
      "@better-auth/passkey": "1.7.7",
      "@better-auth/sso": "1.7.7",
      "@hono/zod-openapi": "1.6.3",
      "@t3-oss/env-core": "0.13.11",
      "@t3-oss/env-nextjs": "0.13.11",
      "@tailwindcss/postcss": "4.3.3",
      "@types/bun": "1.4.2",
      "@types/node": "^24",
      "@types/pg": "8.23.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "ai": "7.0.137",
      "auth": "1.7.7",
      "better-auth": "1.7.7",
      "drizzle-kit": "0.31.11",
      "drizzle-orm": "0.45.4",
      "hono": "4.13.13",
      "iovalkey": "0.4.0",
      "lucide-react": "1.54.0",
      "next": "16.4.0",
      "pg": "8.23.1",
      "pg-boss": "12.33.7",
      "postcss": "8.5.29",
      "publint": "0.3.25",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "server-only": "0.0.1",
      "tailwindcss": "4.3.3",
      "tsdown": "0.23.0",
      "typescript": "7.0.2",
      "zod": "4.6.5"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "bun run db:migrate:test && turbo run test",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:migrate:test": "bun run --cwd packages/db db:migrate:test",
    "db:studio": "bun run --cwd packages/db db:studio",
    "db:seed": "bun run --cwd packages/tenancy db:seed",
    "admin:create": "bun run --cwd packages/tenancy admin:create",
    "ses:bootstrap": "bun run --cwd apps/worker ses:bootstrap",
    "valkey:bootstrap": "bun run --cwd packages/ratelimit valkey:bootstrap",
    "ratelimit:set": "bun run --cwd packages/ratelimit ratelimit:set",
    "auth:generate": "bun run --cwd packages/auth auth:generate && biome check --write packages/db/src/schema/auth.ts",
    "auth:update-disposable": "bun run --cwd packages/auth auth:update-disposable",
    "openapi:generate": "bun run --cwd apps/api openapi:generate",
    "changeset": "changeset",
    "version-packages": "changeset version && bun packages/sdk/scripts/sync-version.ts && bun install --lockfile-only && biome check --write packages/sdk/package.json packages/sdk/src/version.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "turbo": "2.11.7",
    "typescript": "catalog:"
  }
}

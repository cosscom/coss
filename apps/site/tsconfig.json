{
  "extends": "@coss/tsconfig/nextjs.json",
  "compilerOptions": {
    // Bun types are for the bun:test files in test/.
    "types": ["node", "bun"],
    // kloq (packages/kloq and src/components/calendar, from cosscom/calendar) is
    // written without it, and its sources are type-checked through this app's imports.
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts"
  ],
  "exclude": ["node_modules", ".twoslash"]
}

# Build context for apps/*/Dockerfile (always the repository root). Images are configured at
# runtime, so no env file may ever reach one: Bun and the package scripts would load it.
.env
.env.*
**/.env
**/.env.*

.git
**/node_modules
**/.next
**/.turbo
**/dist
**/coverage
**/*.tsbuildinfo
**/next-env.d.ts
apps/site/.source
apps/site/.twoslash
apps/mobile/.expo
apps/mobile/ios
apps/mobile/android
out
.DS_Store
.vscode
.claude
CLAUDE.local.md

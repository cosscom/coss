# Copy to .env (repo root). Every app/package loads this single file.

# Postgres. The postgres:postgres form below matches CI; with Postgres.app use your macOS user and no
# password, e.g. postgres://<you>@localhost:5432/coss. On RDS add
# ?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem (the images ship that CA bundle).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coss
# Used by `bun run test`. Must point at a database whose name ends in `_test`.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/coss_test
# Optional pg pool size per process (default 10). Tasks × pool size must stay below RDS max_connections.
# DATABASE_POOL_MAX=10

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Origin of the dashboard (apps/web), which hosts /api/auth/*. In production https://coss.com, the
# origin both zones (site and dashboard) share.
BETTER_AUTH_URL=http://localhost:3000

# Public API (apps/api)
API_PORT=3001
# Public origin of the API: OpenAPI, dashboard snippets and email tracking URLs (API + worker).
# Read at runtime. Required in production and by the dashboard.
API_PUBLIC_URL=http://localhost:3001
# Browser origins allowed to call the API (the docs' API playground), comma-separated. Defaults to
# https://coss.com; locally, the docs run on :3002.
API_CORS_ORIGINS=http://localhost:3002

# Provider used by `live` (production) environments: `fake` (nothing is sent; domains verify
# without DNS) or `ses`. Sandbox environments always use the fake provider.
EMAIL_PROVIDER=fake
# Required with EMAIL_PROVIDER=ses; `bun run ses:bootstrap` creates the AWS side and prints them.
# AWS credentials come from the default chain (AWS_PROFILE, AWS_ACCESS_KEY_ID/…, or a role).
# AWS_REGION=eu-west-1
# SES_CONFIGURATION_SET=coss
# SES_TENANT_PREFIX=coss
# SES_EVENTS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/coss-events

# AI content screening (worker): a sample of each organization's live emails is classified before
# it is sent; confident spam/phishing is blocked and suspends the organization. `off`, `fake`
# (no network: content containing `[coss-test:phishing]` etc. is flagged) or `ai` (a decision
# model through Vercel AI Gateway, by default TypeSafe AI's Jev; needs AI_GATEWAY_API_KEY).
SCREENING_CLASSIFIER=fake
# SCREENING_MODEL=typesafe-ai/jev
# AI_GATEWAY_API_KEY=

# Environment logs (API requests, email events, webhook attempts; worker): days kept, 1-31 (default 30).
# LOG_RETENTION_DAYS=30

# COSS's own emails (worker): account emails (sign-up verification, password resets, invitations) and
# reputation notifications (warnings and suspensions, to each organization's owners and admins) go out
# through COSS itself, from a live environment of COSS's own organization (its id, env_…) with an
# address on one of that organization's verified domains. Set both or neither. Unset, account email
# links are only printed by the dashboard (development) and both kinds are held until configured
# (production). Links point at BETTER_AUTH_URL.
# NOTIFICATIONS_ENVIRONMENT_ID=env_…
# NOTIFICATIONS_FROM=COSS <notifications@coss.com>

# Encrypts webhook endpoint signing secrets at rest (API, dashboard + worker). 32 bytes, base64:
#   openssl rand -base64 32
# Losing or changing it makes existing endpoints' secrets unreadable.
WEBHOOK_SECRETS_KEY=

# Rate limiting. Counters live in Valkey (ElastiCache Serverless in production: `bun run
# valkey:bootstrap` creates it and prints these). Required in production; unset in development,
# each process counts in memory. Locally: `valkey-server` (or redis-server) and redis://localhost:6379
# VALKEY_URL=redis://localhost:6379
# VALKEY_CLUSTER=false
# Namespaces keys, so several stages can share one cache (default coss).
# RATE_LIMIT_KEY_PREFIX=coss
# The header your load balancer puts the caller's address in. Unset, per-IP limits (failed API
# keys, dashboard sign-in/sign-up/password reset) are off. With x-forwarded-for, TRUSTED_PROXY_COUNT
# is how many of your proxies append to it (default 1).
# CLIENT_IP_HEADER=x-forwarded-for
# TRUSTED_PROXY_COUNT=1
# Used by `bun run test` (rate limiter tests). Tests only add keys under a random prefix.
TEST_VALKEY_URL=redis://localhost:6379

# Dashboard (apps/web) behind proxies. Server Actions encrypt closed-over values with this key; every
# dashboard instance of a stage must share it (`openssl rand -base64 32`). Required in production.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Proxies in front of the dashboard that append to X-Forwarded-For (CloudFront → ALB: 2). 0 (default)
# trusts no forwarded client address.
# TRUSTED_PROXY_HOPS=0

# Image builds only (apps/*/Dockerfile passes the commit): Next's build id and version-skew protection.
# NEXT_DEPLOYMENT_ID=

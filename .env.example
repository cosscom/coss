# Copy to .env (repo root). Every app/package loads this single file.

# Postgres. The postgres:postgres form below matches CI; with Postgres.app use your macOS user and no
# password, e.g. postgres://<you>@localhost:5432/coss. On RDS add
# ?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem (the images ship that CA bundle).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coss
# Used by `bun run test`. Must point at a database whose name ends in `_test`.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/coss_test
# Optional pg pool size per process (default 10). Tasks × pool size must stay below RDS max_connections.
# DATABASE_POOL_MAX=10

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Origin of the dashboard (apps/web), which hosts /api/auth/*. In production https://coss.com, the
# origin both zones (site and dashboard) share.
BETTER_AUTH_URL=http://localhost:3000

# Public API (apps/api)
API_PORT=3001
# Public origin of the API: OpenAPI, dashboard snippets and email tracking URLs (API + worker).
# Read at runtime. Required in production and by the dashboard.
API_PUBLIC_URL=http://localhost:3001
# Where the Hooks portal is served (apps/portal); portal session links point here.
PORTAL_PUBLIC_URL=http://localhost:3003
# Browser origins allowed to call the API (the docs' API playground), comma-separated. Defaults to
# https://coss.com; locally, the docs run on :3002.
API_CORS_ORIGINS=http://localhost:3002

# Provider used by `live` (production) environments: `fake` (nothing is sent; domains verify
# without DNS) or `ses`. Sandbox environments always use the fake provider.
EMAIL_PROVIDER=fake
# Required with EMAIL_PROVIDER=ses; `bun run ses:bootstrap` creates the AWS side and prints them.
# AWS credentials come from the default chain (AWS_PROFILE, AWS_ACCESS_KEY_ID/…, or a role).
# AWS_REGION=eu-west-1
# SES_CONFIGURATION_SET=coss
# SES_TENANT_PREFIX=coss
# SES_EVENTS_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/coss-events

# Receiving email (API, dashboard + worker). Each environment gets `<anything>@<label>.<domain>`
# addresses under INBOUND_MANAGED_DOMAIN (default `inbound.coss.test` with the fake provider:
# use the dashboard's "Send a test email" to receive locally). With SES, `bun run ses:bootstrap
# --managed-domain inbound.coss.com` creates the receipt rule, bucket and queue and prints all
# three (the queue is the worker's only). Unset with SES: receiving is off.
# INBOUND_MANAGED_DOMAIN=inbound.coss.com
# SES_INBOUND_BUCKET=coss-inbound-123456789012
# SES_INBOUND_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789012/coss-inbound

# Custom tracking domains (API, dashboard + worker): `fake` (default: active at once, nothing serves
# them) or `cloudflare` (Cloudflare for SaaS custom hostnames on the cosslinks.com zone, which issue
# their certificates and proxy /t/* to the API; needs the token and zone id). Customers CNAME their
# tracking domain to TRACKING_CNAME_TARGET (default track.cosslinks.com).
# TRACKING_DOMAIN_PROVIDER=cloudflare
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# TRACKING_CNAME_TARGET=track.cosslinks.com
# Origin of open/click tracking links (API + worker; default API_PUBLIC_URL). Production:
# TRACKING_PUBLIC_URL=https://track.cosslinks.com

# SMTP relay (apps/smtp): username `coss`, an API key as the password. Locally it listens on 2465
# (implicit TLS) and 2587 (STARTTLS) with a self-signed certificate made by `openssl` (clients must
# skip verification), and accepts AUTH without TLS on localhost. Production exports an ACM
# certificate (SMTP_TLS_CERTIFICATE_ARN + SMTP_TLS_PASSPHRASE) and the NLB maps 465/587 too.
# SMTP_HOSTNAME=localhost
# SMTP_IMPLICIT_TLS_PORT=2465
# SMTP_STARTTLS_PORT=2587
# SMTP_TLS_CERT_FILE=
# SMTP_TLS_KEY_FILE=
# The relay's host the dashboard shows (default localhost outside production; unset hides it).
# SMTP_PUBLIC_HOST=smtp.coss.com

# AI content screening (worker): a sample of each organization's live emails is classified before
# it is sent; confident spam/phishing is blocked and suspends the organization. `off`, `fake`
# (no network: content containing `[coss-test:phishing]` etc. is flagged) or `ai` (a decision
# model through Vercel AI Gateway, by default TypeSafe AI's Jev; needs AI_GATEWAY_API_KEY).
SCREENING_CLASSIFIER=fake
# SCREENING_MODEL=typesafe-ai/jev
# AI_GATEWAY_API_KEY=

# Billing (dashboard + worker): the payment provider new billing accounts use. `fake` (default:
# every charge succeeds, nothing leaves COSS) or `stripe` (needs STRIPE_SECRET_KEY; the dashboard's
# webhook route https://<dashboard>/api/billing/webhook also needs STRIPE_WEBHOOK_SECRET). Locally:
# `stripe listen --forward-to localhost:3000/api/billing/webhook` prints a webhook secret.
# BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…

# Environment logs (API requests, email events, webhook attempts; worker): days kept, 1-31 (default 30).
# LOG_RETENTION_DAYS=30

# COSS's own emails (worker): account emails (sign-up verification, password resets, invitations) and
# reputation notifications (warnings and suspensions, to each organization's owners and admins) go out
# through COSS itself, from a live environment of COSS's own organization (its id, env_…) with an
# address on one of that organization's verified domains. Set both or neither. Unset, account email
# links are only printed by the dashboard (development) and both kinds are held until configured
# (production). Links point at BETTER_AUTH_URL.
# NOTIFICATIONS_ENVIRONMENT_ID=env_…   (also read by the dashboard: admins can't suspend its org)
# NOTIFICATIONS_FROM=COSS <notifications@coss.com>

# Encrypts webhook endpoint signing secrets at rest (API, dashboard + worker). 32 bytes, base64:
#   openssl rand -base64 32
# Losing it makes existing endpoints' secrets unreadable. To change it, list several keys, newest
# first (`<new>,<old>`: the first encrypts, all decrypt), then `bun run webhooks:reencrypt` and
# drop the old one (README.md, "Rotating WEBHOOK_SECRETS_KEY").
WEBHOOK_SECRETS_KEY=

# Keys the hashes risk assessments remember identifiers by (velocity, duplicate accounts, fraud
# reports) (API + dashboard). 32 bytes, base64: `openssl rand -base64 32`. Required in production;
# unset elsewhere, a fixed development key is used. Changing it resets that memory.
# RISK_HASH_KEY=
# Risk's content classification (API, live environments): `off` (classify returns 503, assessments
# skip content), `fake` (the `[coss-test:<category>]` markers, no network) or `ai` (SCREENING_MODEL
# through Vercel AI Gateway with AI_GATEWAY_API_KEY). Sandbox environments always use the markers.
RISK_CLASSIFIER=fake
# The worker downloads IPinfo's free "Lite" database (ASN and country) for risk's IP signals with
# this token (https://ipinfo.io/signup). Unset: Tor and cloud ranges only.
# IPINFO_TOKEN=
# VPN, proxy and relay data per address for risk (API + dashboard): `off` (default; only the
# network-level VPN guess) or `ipinfo` (IPinfo's privacy detection, a paid plan's token in
# IPINFO_PRIVACY_TOKEN). It sends every assessed public IP address to IPinfo.
# RISK_IP_PRIVACY=off
# IPINFO_PRIVACY_TOKEN=
# Dogfooding: a live environment of your own organization whose COSS Risk assesses the dashboard's
# sign-ups (`block` refuses them). Unset: sign-ups aren't assessed.
# RISK_SIGNUP_ENVIRONMENT_ID=

# Error and performance monitoring (Sentry, organization `coss`). One DSN per service: the
# dashboard's (project `web`) also serves every browser on coss.com through /api/monitoring; the API
# and worker report to `api` and `worker`. Unset: nothing is reported.
# SENTRY_DSN=https://<key>@o<org id>.ingest.us.sentry.io/<project id>
# The stage (defaults to NODE_ENV) and the share of requests/jobs traced (default 0.1).
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=1
# Builds only: uploads the Next.js apps' source maps (an organization token with project:releases).
# SENTRY_AUTH_TOKEN=

# Rate limiting. Counters live in Valkey (ElastiCache Serverless in production: `bun run
# valkey:bootstrap` creates it and prints these). Required in production; unset in development,
# each process counts in memory. Locally: `valkey-server` (or redis-server) and redis://localhost:6379
# VALKEY_URL=redis://localhost:6379
# VALKEY_CLUSTER=false
# Namespaces keys, so several stages can share one cache (default coss).
# RATE_LIMIT_KEY_PREFIX=coss
# The header your load balancer puts the caller's address in. Unset, per-IP limits (failed API
# keys, dashboard sign-in/sign-up/password reset) are off. With x-forwarded-for, TRUSTED_PROXY_COUNT
# is how many of your proxies append to it (default 1).
# CLIENT_IP_HEADER=x-forwarded-for
# TRUSTED_PROXY_COUNT=1
# Used by `bun run test` (rate limiter tests). Tests only add keys under a random prefix.
TEST_VALKEY_URL=redis://localhost:6379

# Dashboard (apps/web) behind proxies. Server Actions encrypt closed-over values with this key; every
# dashboard instance of a stage must share it (`openssl rand -base64 32`). Required in production.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Proxies in front of the dashboard that append to X-Forwarded-For (CloudFront → ALB: 2). 0 (default)
# trusts no forwarded client address.
# TRUSTED_PROXY_HOPS=0
# Cloudflare Turnstile on dashboard sign-up, sign-in and password reset (a widget whose hostnames
# include the dashboard's). Both or neither; required in production. Unset, there is no human check.
# Cloudflare's test keys: site 1x00000000000000000000AA + secret 1x0000000000000000000000000000000AA
# always pass; secret 2x0000000000000000000000000000000AA always fails.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Sign-in with Google and GitHub (dashboard). Each provider is on when both of its values are set.
# Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/google and …/callback/github
# (locally http://localhost:3000/api/auth/callback/…; GitHub OAuth apps take one callback each,
# so use a separate development app).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Image builds only (apps/*/Dockerfile passes the commit): Next's build id and version-skew protection.
# NEXT_DEPLOYMENT_ID=

# CI build job only: `next build` skips its TypeScript check (the typecheck job covers it).
# SKIP_BUILD_TYPECHECK=1

# Not here: TURBO_TOKEN / TURBO_TEAM / TURBO_REMOTE_CACHE_SIGNATURE_KEY (the shared build cache) go in your shell
# environment, because turbo never reads this file. See README, "Remote cache".

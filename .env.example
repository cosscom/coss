# Copy to .env (repo root). Every app/package loads this single file.

# Postgres. The postgres:postgres form below matches CI; with Postgres.app use your macOS user and no
# password, e.g. postgres://<you>@localhost:5432/coss
DATABASE_URL=postgres://postgres:postgres@localhost:5432/coss
# Used by `bun run test`. Must point at a database whose name ends in `_test`.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/coss_test
# Optional pg pool size per process (default 10).
# DATABASE_POOL_MAX=10

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Origin of the dashboard (apps/web), which hosts /api/auth/*
BETTER_AUTH_URL=http://localhost:3000

# Public API (apps/api)
API_PORT=3001
# Public origin of the API (used in the OpenAPI document). Optional in development.
API_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Provider used by `live` (production) environments. Sandbox environments always use the fake provider.
EMAIL_PROVIDER=fake
